<?xml version="1.0" ?>
<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xsi:schemaLocation="     http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd     http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd     http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd     http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
  <munit:config name="test_suite_get_members_memberid_loyalty_management_1749662.xml"/>
  <munit:test name="test_suite_get_members_memberid_loyalty_management_0" description="Test successful retrieval of member profile details through the complete flow including token retrieval and member API call">
    <!-- 
        Behavior Section:
        - Set the event with HTTP request attributes, including Authorization header and memberId URI param.
        - Mock the HTTP request for member profile details to return a successful member profile response.
        - Mock the cache to simulate a cache miss (token retrieval will be executed).
    -->
    <munit:behavior>
      <!-- Set the incoming HTTP event with attributes and variables -->
      <munit:set-event doc:name="Set Event">
        <munit:payload value="#[null]"/>
        <munit:attributes value="#[{                 version: '1.0',                 method: 'GET',                 scheme: 'HTTP',                 requestPath: '/members/675424',                 queryParams: {},                 headers: {                     authorization: 'Bearer dummyOldToken'                 },                 uriParams: {                     memberId: '675424'                 }             }]" mediaType="application/java" encoding="UTF-8"/>
      </munit:set-event>
      <!-- Mock cache: simulate cache miss for token (so token retrieval is executed) -->
      <munit-tools:mock-when processor="ee:cache">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Cache" attributeName="doc:name"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[null]" mediaType="application/java" encoding="UTF-8"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <!-- Mock HTTP request for member profile details (Retrieve Member Profile Details) -->
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retrieve Member Profile Details" attributeName="doc:name"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[MunitTools::getResourceAsString('test_suite_get_members_memberid_loyalty_management_1749662/mock_data_scenario_0/member_profile_response.json')]" mediaType="application/json" encoding="UTF-8"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <!-- 
        Execution Section:
        - Execute the main flow under test.
    -->
    <munit:execution>
      <flow-ref name="get:\members\(memberId):loyalty-management-api-config"/>
    </munit:execution>
    <!-- 
        Validation Section:
        - Verify all required loggers and HTTP requests are called.
        - Assert the payload matches the expected member profile response.
        - Only verify DEBUG logger for member API call (not for token retrieval).
    -->
    <munit:validation>
      <!-- Verify INFO logger "Request Received" is called -->
      <munit-tools:verify-call doc:name="Verify INFO: Request Received" processor="logger" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="INFO: Request Received" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify DEBUG logger "Outbound Request" for member API is called -->
      <munit-tools:verify-call doc:name="Verify DEBUG: Outbound Request (Member API)" processor="logger" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="DEBUG: Outbound Request" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify HTTP request "Retrieve Member Profile Details" is called -->
      <munit-tools:verify-call doc:name="Verify HTTP: Retrieve Member Profile Details" processor="http:request" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retrieve Member Profile Details" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify DEBUG logger "Outbound Response" for member API is called -->
      <munit-tools:verify-call doc:name="Verify DEBUG: Outbound Response (Member API)" processor="logger" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="DEBUG: Outbound Response" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify INFO logger "Request Completed" is called -->
      <munit-tools:verify-call doc:name="Verify INFO: Request Completed" processor="logger" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="INFO: Request Completed" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Assert that the payload matches the expected member profile data -->
      <munit-tools:assert-equals doc:name="Assert Member Profile Payload" actual="#[payload]" expected="#[read(MunitTools::getResourceAsString('test_suite_get_members_memberid_loyalty_management_1749662/mock_data_scenario_0/member_profile_response.json'),'application/json')]" message="Payload does not match expected member profile response"/>
    </munit:validation>
  </munit:test>
  <munit:test name="test_suite_get_members_memberid_loyalty_management_1" doc:id="test-error-handling-bad-request" description="Test error handling for non-retryable errors (HTTP:BAD_REQUEST) in member profile retrieval">
    <munit:behavior>
      <!-- Mock the HTTP request "Retrieve Member Profile Details" to throw HTTP:BAD_REQUEST error with error message payload -->
      <munit-tools:mock-when doc:name="Mock Retrieve Member Profile Details - BAD_REQUEST" processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retrieve Member Profile Details" attributeName="doc:name"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:error typeId="HTTP:BAD_REQUEST"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <!-- Set event with HTTP request attributes including authorization header and memberId URI parameter -->
      <munit:set-event doc:name="Set Event">
        <munit:attributes value="#[{                 headers: {                     authorization: 'Bearer AQoAQJ...'                 },                 uriParams: {                     memberId: '675424'                 }             }]" mediaType="application/java" encoding="UTF-8"/>
      </munit:set-event>
      <!-- Execute the flow -->
      <flow-ref doc:name="Execute get:\members\(memberId):loyalty-management-api-config" name="get:\members\(memberId):loyalty-management-api-config"/>
    </munit:execution>
    <munit:validation>
      <!-- Verify that the INFO logger "Request Received" is called -->
      <munit-tools:verify-call doc:name="Verify INFO: Request Received" processor="logger">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="INFO: Request Received" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify that the HTTP request "Retrieve Member Profile Details" is called -->
      <munit-tools:verify-call doc:name="Verify HTTP Request Called" processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retrieve Member Profile Details" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify that the ERROR logger "Non Retryable Error" is called -->
      <munit-tools:verify-call doc:name="Verify ERROR: Non Retryable Error" processor="logger">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="ERROR: Non Retryable Error" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify that the INFO logger "Request Completed" is called -->
      <munit-tools:verify-call doc:name="Verify INFO: Request Completed" processor="logger">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="INFO: Request Completed" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>
</mule>