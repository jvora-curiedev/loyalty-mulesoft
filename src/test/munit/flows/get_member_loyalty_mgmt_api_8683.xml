  <munit:test name="get_member_loyalty_mgmt_api_1" description="Test HTTP connectivity error scenario where the external API call fails and gets retried by until-successful scope" expectedErrorType="HTTP:CONNECTIVITY">
    <munit:behavior>
      <!-- Mock the HTTP request to throw HTTP:CONNECTIVITY error -->
      <munit-tools:mock-when doc:name="Mock Retrieve Member Profile Details" processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retrieve Member Profile Details" attributeName="doc:name"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:error typeId="HTTP:CONNECTIVITY"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <!-- Set event with proper attributes including authorization header and memberId URI parameter -->
      <munit:set-event doc:name="Set Event with Authorization and memberId">
        <munit:attributes value="#[{                 'headers': {                     'authorization': 'Bearer 00DDn00000C16Vj!AQkAQCtjycNRLBS4kJE51z2xyEBxVcPpKacsIZ68c2pMuSqoDKrD7rHYF.gtCwqpa31jASZ8qmJ_56hE1pf8W2yGvUGfBy5C',                     'content-type': 'application/json',                     'accept': 'application/json'                 },                 'uriParams': {                     'memberId': '0lMDn000001qkTHMAY'                 },                 'queryParams': {},                 'requestPath': '/api/members/0lMDn000001qkTHMAY',                 'method': 'GET'             }]" mediaType="application/java" encoding="UTF-8"/>
      </munit:set-event>
      <!-- Execute the flow -->
      <flow-ref doc:name="get:\members\(memberId):loyalty-management-api-config" name="get:\members\(memberId):loyalty-management-api-config"/>
    </munit:execution>
    <munit:validation>
      <!-- Verify that the HTTP request connector is called -->
      <munit-tools:verify-call doc:name="Verify HTTP Request Called" processor="http:request" times="3">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retrieve Member Profile Details" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify that the DEBUG logger "Outbound Request" is called -->
      <munit-tools:verify-call doc:name="Verify DEBUG Outbound Request Logger" processor="logger" times="3">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="DEBUG: Outbound Request" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify that the ERROR logger "Connectivity or Timeout" is called -->
      <munit-tools:verify-call doc:name="Verify ERROR Connectivity Logger" processor="logger" times="3">
