          <munit-tools:with-attribute whereValue="ERROR: Connectivity or Timeout" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <!-- Verify that the until-successful scope attempts retry mechanism -->
      <munit-tools:verify-call doc:name="Verify Until Successful Retry" processor="until-successful" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute whereValue="Retry" attributeName="doc:name"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>
