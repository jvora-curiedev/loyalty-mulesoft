<munit:test name="process_orders_flow_2" doc:id="8251a1be-cc8f-4993-8c2c-d4438917c59c" description="Test execution with only placed orders processed.">
  <munit:behavior>
    <munit-tools:mock-when doc:name="Mock retrieve-token-subflow" doc:id="ef5973fe-04f1-427a-971a-2bf0bbf044b8" processor="flow-ref">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute whereValue="retrieve-token-subflow" attributeName="name"/>
      </munit-tools:with-attributes>
      <munit-tools:then-return>
        <munit-tools:payload value="#[vars.authAccessToken]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
    <munit-tools:mock-when doc:name="Mock send-orders-to-salesforce-flow" doc:id="17376d95-a11a-44e5-a564-c639a988c945" processor="flow-ref">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute whereValue="send-orders-to-salesforce-flow" attributeName="name"/>
      </munit-tools:with-attributes>
    </munit-tools:mock-when>
    <munit-tools:mock-when doc:name="Mock Anypoint MQ" doc:id="0760232e-6a53-4eaf-b760-724a544e803a" processor="anypoint-mq:consume">
      <munit-tools:then-return>
        <munit-tools:payload value="#[output application/json --- readUrl('classpath://examples/qo2s4/placed-orders.json')]"/>
        <munit-tools:attributes value="#[output application/java --- {ackToken: 'ackToken1'}]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
    <munit-tools:mock-when doc:name="Mock error handler" doc:id="83c5f701-fc03-4a30-8911-b5a7bcc2cf46" processor="on-error-continue"/>
  </munit:behavior>
  <munit:execution>
    <flow-ref doc:name="process-orders-flow" doc:id="8251a1be-cc8f-4993-8c2c-d4438917c59c" name="process-orders-flow"/>
  </munit:execution>
  <munit:validation>
    <munit-tools:verify-call doc:name="Verify retrieve-token-subflow call" doc:id="ef5973fe-04f1-427a-971a-2bf0bbf044b8" processor="flow-ref" times="1"/>
    <munit-tools:verify-call doc:name="Verify send-orders-to-salesforce-flow call" doc:id="17376d95-a11a-44e5-a564-c639a988c945" processor="flow-ref" times="1"/>
    <munit-tools:verify-call doc:name="Verify Anypoint MQ call" doc:id="0760232e-6a53-4eaf-b760-724a544e803a" processor="anypoint-mq:consume" times="1"/>
    <munit-tools:verify-call doc:name="Verify error handler not called" doc:id="83c5f701-fc03-4a30-8911-b5a7bcc2cf46" processor="on-error-continue" times="0"/>
  </munit:validation>
</munit:test>

